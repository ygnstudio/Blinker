{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "项目与联系": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project & Contact"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目与联系"
          }
        }
      }
    },
    "规则与窗口内容在本机处理，不上传数据，不收集使用统计。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules and window content are processed on this Mac. No data is uploaded and no usage analytics are collected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则与窗口内容在本机处理，不上传数据，不收集使用统计。"
          }
        }
      }
    },
    "辅助功能用于识别和操作窗口。屏幕录制仅用于可选缩略图，图像只缓存在内存中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is used to identify and control windows. Screen Recording is only needed for optional thumbnails, which are cached in memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能用于识别和操作窗口。屏幕录制仅用于可选缩略图，图像只缓存在内存中。"
          }
        }
      }
    },
    "外部链接由默认浏览器打开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External links open in your default browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部链接由默认浏览器打开。"
          }
        }
      }
    },
    "查看许可证": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View License"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看许可证"
          }
        }
      }
    },
    "允许商业使用和收费分发，分发时须遵守 GPLv3 的源码与许可要求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commercial use and paid distribution are permitted. Distribution must meet the source code and licensing requirements of GPLv3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许商业使用和收费分发，分发时须遵守 GPLv3 的源码与许可要求。"
          }
        }
      }
    },
    "开源许可": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source License"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源许可"
          }
        }
      }
    },
    "macOS 窗口工具": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window controls for macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 窗口工具"
          }
        }
      }
    },
    "自定义红绿灯动作，放大悬停按钮，预览、切换和整理窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize traffic-light actions, enlarge buttons on hover, and preview, switch or arrange windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义红绿灯动作，放大悬停按钮，预览、切换和整理窗口。"
          }
        }
      }
    },
    "源代码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源代码"
          }
        }
      }
    },
    "版本 %@（构建 %@）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (Build %@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@（构建 %@）"
          }
        }
      }
    },
    "%lld 个窗口": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld window"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld windows"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个窗口"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个窗口"
                }
              }
            }
          }
        }
      }
    },
    "Blinker 不上传规则或窗口内容。你可以跳过授权，之后在设置中开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker does not upload rules or window content. You can skip permissions and enable them in settings later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker 不上传规则或窗口内容。你可以跳过授权，之后在设置中开启。"
          }
        }
      }
    },
    "Blinker 使用引导": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting Started with Blinker"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker 使用引导"
          }
        }
      }
    },
    "Blinker 常驻菜单栏，应用规则和设置使用独立窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker lives in the menu bar. App rules and settings open in their own windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker 常驻菜单栏，应用规则和设置使用独立窗口。"
          }
        }
      }
    },
    "Blinker 悬浮测试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker Hover Test"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker 悬浮测试"
          }
        }
      }
    },
    "Dock 预览": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Previews"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 预览"
          }
        }
      }
    },
    "GNU 官方许可证": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official GNU License"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU 官方许可证"
          }
        }
      }
    },
    "↵ 打开 · Esc 取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↵ Open · Esc Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "↵ 打开 · Esc 取消"
          }
        }
      }
    },
    "⌥+左键": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥+Left Click"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥+左键"
          }
        }
      }
    },
    "⌥Tab 已被其他应用占用。请停用冲突的快捷键后重新开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥Tab is unavailable. Disable the conflicting shortcut in the other app, then enable this again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥Tab 已被其他应用占用。请停用冲突的快捷键后重新开启。"
          }
        }
      }
    },
    "。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "。"
          }
        }
      }
    },
    "「跟随系统」读取系统深浅色设置；更改立即生效。外观仅作用于设置窗口；悬停放大的液态玻璃始终跟随系统深浅色。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow System reads the system appearance; changes apply immediately. The appearance setting styles the settings window only — the hover overlay's glass always follows the system appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟随系统」读取系统深浅色设置；更改立即生效。外观仅作用于设置窗口；悬停放大的液态玻璃始终跟随系统深浅色。"
          }
        }
      }
    },
    "三分屏": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thirds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三分屏"
          }
        }
      }
    },
    "上一步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
