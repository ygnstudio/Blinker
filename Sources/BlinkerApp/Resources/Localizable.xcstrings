    },
    "⌥Tab 独立启用，在「预览与切换」中设置，不受下方自定义快捷键开关影响。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Tab is enabled separately in Previews & Switching. The custom shortcut switch below does not affect it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥Tab 独立启用，在「预览与切换」中设置，不受下方自定义快捷键开关影响。"
          }
        }
      }
    },
    "保存并恢复一组窗口的位置和大小。关闭此功能会保留已有布局；同应用的相似窗口可能匹配错误，移回原桌面使用非公开系统接口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and restore window positions and sizes. Turning this off keeps saved layouts. Similar windows in the same app may be mismatched; restoring their original Space uses private system APIs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存并恢复一组窗口的位置和大小。关闭此功能会保留已有布局；同应用的相似窗口可能匹配错误，移回原桌面使用非公开系统接口。"
          }
        }
      }
    },
    "参数预设": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数预设"
          }
        }
      }
    },
    "开合触发": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lid Motion Trigger"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开合触发"
          }
        }
      }
    },
    "每次开盖或合盖至少移动设定幅度才触发。数值越大，越容易忽略轻微晃动。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening or closing must move through at least this angle to trigger the effect. A larger value ignores more small movements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次开盖或合盖至少移动设定幅度才触发。数值越大，越容易忽略轻微晃动。"
          }
        }
      }
    },
    "桌面随合盖逐渐倾斜、雾化和变暗。关闭特效时仍可调整参数并查看模拟预览。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop tilts, blurs and dims as the lid closes. You can adjust the settings and use the simulated preview while the effect is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面随合盖逐渐倾斜、雾化和变暗。关闭特效时仍可调整参数并查看模拟预览。"
          }
        }
      }
    },
    "校准与强度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration & Strength"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准与强度"
          }
        }
      }
    },
    "先把屏幕放到平时使用的角度再校准。参考角度决定效果起点，跨度越大，画面变化越缓。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the display to your usual angle before calibrating. The reference angle sets where the effect begins; a larger span makes the change more gradual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先把屏幕放到平时使用的角度再校准。参考角度决定效果起点，跨度越大，画面变化越缓。"
          }
        }
      }
    },
    "动画与结束方式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation & Ending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画与结束方式"
          }
        }
      }
    },
    "停稳后按延时淡出；开启保持后，重新开盖才恢复画面。动画速度只调整过渡快慢，100% 为原速。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The effect fades after the delay when motion stops. With hold enabled, reopen the lid to clear it. Animation speed only changes transitions; 100% is the original speed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停稳后按延时淡出；开启保持后，重新开盖才恢复画面。动画速度只调整过渡快慢，100% 为原速。"
          }
        }
      }
    },
    "窗口预览与切换需要辅助功能权限。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window previews and switching require Accessibility access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口预览与切换需要辅助功能权限。"
          }
        }
      }
    },
    "键盘窗口切换": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard Window Switching"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘窗口切换"
          }
        }
      }
    },
    "Dock 悬停预览": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Hover Previews"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 悬停预览"
          }
        }
      }
    },
    "共用的显示内容": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared Content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共用的显示内容"
          }
        }
      }
    },
    "共用的预览外观": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared Preview Appearance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共用的预览外观"
          }
        }
      }
    },
    "标签页支持标准 macOS 标签栏和 Safari；没有缓存画面的后台标签页显示图标和标题。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs are supported for standard macOS tab bars and Safari. Background tabs without a cached image show their icon and title."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页支持标准 macOS 标签栏和 Safari；没有缓存画面的后台标签页显示图标和标题。"
          }
        }
      }
    },
    "打开窗口面板…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Window Panel…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开窗口面板…"
          }
        }
      }
    },
    "显示内容和预览外观供键盘切换、Dock 悬停预览与手动窗口面板共用。缩略图只在面板打开时采集并缓存在内存中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content and appearance settings apply to keyboard switching, Dock hover previews, and manually opened window panels. Thumbnails are captured only while a panel is open and cached in memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示内容和预览外观供键盘切换、Dock 悬停预览与手动窗口面板共用。缩略图只在面板打开时采集并缓存在内存中。"
          }
        }
      }
    },
    "启用窗口增强": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Window Enhancements"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用窗口增强"
          }
        }
      }
    },
    "控制窗口按钮、预览切换、贴靠、Dock 收起和快捷键。开合盖特效与状态图标独立运行，关闭本开关会保留所有设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls window buttons, previews and switching, snapping, Dock minimization, and shortcuts. Lid effects and status icons run independently. Turning this off preserves all settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制窗口按钮、预览切换、贴靠、Dock 收起和快捷键。开合盖特效与状态图标独立运行，关闭本开关会保留所有设置。"
          }
        }
      }
    },
    "点击保护": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Protection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击保护"
          }
        }
      }
    },
    "保护期间点击不会执行，进度环结束后再点。仅保护退出时，其他操作立即响应；保护时间为零时，所有操作立即响应。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicks are ignored during the protection period. Click again after the progress ring completes. Protecting only Quit leaves other actions immediate; a zero duration makes all actions immediate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护期间点击不会执行，进度环结束后再点。仅保护退出时，其他操作立即响应；保护时间为零时，所有操作立即响应。"
          }
        }
      }
    },
    "配置窗口快捷键…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure Window Shortcuts…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置窗口快捷键…"
          }
        }
      }
    },
    "布局与快捷键": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layouts and Shortcuts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局与快捷键"
          }
        }
      }
    },
    "窗口布局和显示桌面的快捷键统一在「快捷键」中设置，与拖拽贴靠分别启用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure window layout and Show Desktop shortcuts in Shortcuts. They are enabled separately from drag-to-snap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口布局和显示桌面的快捷键统一在「快捷键」中设置，与拖拽贴靠分别启用。"
          }
        }
      }
    },
    "状态图标设置分类": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status Icon Settings Categories"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态图标设置分类"
          }
        }
      }
    },
    "恢复状态图标默认设置…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Status Icon Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复状态图标默认设置…"
          }
        }
      }
    },
    "恢复状态图标默认设置？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Status Icon Settings?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复状态图标默认设置？"
          }
        }
      }
    },
    "将重置显示位置、图标、状态面板和音量交互的自定义设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resets the display location, icon, status panel, and volume interaction settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将重置显示位置、图标、状态面板和音量交互的自定义设置。"
          }
        }
      }
    },
    "菜单栏单击": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Bar Click"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏单击"
          }
        }
      }
    },
    "图标大小受系统菜单栏高度限制。右键打开应用规则、设置和暂停菜单。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon size is limited by the system menu bar height. Right-click for application rules, settings, and pause controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标大小受系统菜单栏高度限制。右键打开应用规则、设置和暂停菜单。"
          }
        }
      }
    },
    "点击 Blinker 的 Dock 图标打开状态面板。预览背景不会改变 Dock 图标或系统外观。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Blinker's Dock icon to open the status panel. The preview background does not change the Dock icon or system appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 Blinker 的 Dock 图标打开状态面板。预览背景不会改变 Dock 图标或系统外观。"
          }
        }
      }
    },
    "状态刷新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status Updates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态刷新"
          }
        }
      }
    },
    "状态变化会自动刷新，此间隔用于定期补充检查。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status changes update automatically. This interval controls periodic fallback checks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态变化会自动刷新，此间隔用于定期补充检查。"
          }
        }
      }
    },
    "开启替换后，对应连接类型显示普通 Wi-Fi 图形而非专用标记。中央电量显示开启且电量可用时，电量数字会替代网络或蓝牙图形。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a substitution is enabled, that connection type shows the plain Wi-Fi glyph instead of its dedicated mark. When Show Battery in Center is on and a charge level is available, the number replaces the network or Bluetooth glyph."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启替换后，对应连接类型显示普通 Wi-Fi 图形而非专用标记。中央电量显示开启且电量可用时，电量数字会替代网络或蓝牙图形。"
          }
        }
      }
    },
    "当前音频输出为蓝牙设备时，在图标中央显示设备图形。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the device symbol in the center when the current audio output is a Bluetooth device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前音频输出为蓝牙设备时，在图标中央显示设备图形。"
          }
        }
      }
    },
    "强调色用于音量圆点或圆弧，与中央蓝牙图形分别设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accent color applies to the volume dots or arc, independently of the center Bluetooth symbol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调色用于音量圆点或圆弧，与中央蓝牙图形分别设置。"
          }
        }
      }
    },
    "输出设备列表": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output Device List"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出设备列表"
          }
        }
      }
    },
    "勾选显示并拖动排序。隐藏区块不影响状态图标。隐藏音量区块也会停用面板滚轮调音量；全部隐藏后，仍可进入应用规则和设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check to show and drag to reorder. Hidden sections do not affect the status icon. Hiding Volume also disables scroll-to-adjust in the panel. App Rules and Settings remain available when all sections are hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选显示并拖动排序。隐藏区块不影响状态图标。隐藏音量区块也会停用面板滚轮调音量；全部隐藏后，仍可进入应用规则和设置。"
          }
        }
      }
    },
    "启用音量区块后，滚轮可在所选范围内调节当前输出设备音量。关闭滚轮操作后，仍可使用音量滑块；各项偏好会保留。若与 MOS、Scroll Reverser、LinearMouse 等滚动增强工具冲突，请在其设置中将 Blinker 设为不处理（白名单）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Volume enabled, scrolling within the selected area adjusts the current output device. The volume slider remains available when scrolling is disabled. All preferences are preserved. If scrolling conflicts with enhancement tools such as MOS, Scroll Reverser or LinearMouse, set Blinker to be ignored (whitelisted) in that tool's settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用音量区块后，滚轮可在所选范围内调节当前输出设备音量。关闭滚轮操作后，仍可使用音量滑块；各项偏好会保留。若与 MOS、Scroll Reverser、LinearMouse 等滚动增强工具冲突，请在其设置中将 Blinker 设为不处理（白名单）。"
          }
        }
      }
    },
    "状态图标设置…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status Icon Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态图标设置…"
          }
        }
      }
    },
    "所有状态区块均已隐藏，可在状态图标设置中重新开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All status sections are hidden. Enable them in Status Icon Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有状态区块均已隐藏，可在状态图标设置中重新开启。"
          }
        }
      }
    },
    "暂停窗口增强": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause Window Enhancements"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停窗口增强"
          }
        }
      }
    },
    "恢复窗口增强": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume Window Enhancements"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复窗口增强"
          }
        }
      }
    },
    "打开相关设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open related settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开相关设置"
          }
        }
      }
    },
    "个人热点使用 Wi-Fi 图形": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Wi-Fi glyph for Personal Hotspot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人热点使用 Wi-Fi 图形"
          }
        }
      }
    },
    "临时连接使用 Wi-Fi 图形": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Wi-Fi glyph for ad-hoc connections"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时连接使用 Wi-Fi 图形"
          }
        }
