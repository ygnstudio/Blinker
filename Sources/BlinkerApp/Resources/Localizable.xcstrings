            "value": "悬停放大开关"
          }
        }
      }
    },
    "悬停时以一块液态玻璃托盘衬托放大按钮与扩展按钮，随背景自动融合，无需任何额外权限。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On hover, a Liquid Glass tray sits behind the enlarged buttons and extra chips, blending with any background. No extra permission required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停时以一块液态玻璃托盘衬托放大按钮与扩展按钮，随背景自动融合，无需任何额外权限。"
          }
        }
      }
    },
    "截屏": {
      "localizations": {
        "en": {
          "stringUnit": {
