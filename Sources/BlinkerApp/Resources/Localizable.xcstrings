    "仅保护退出应用操作": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect Quit Actions Only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保护退出应用操作"
          }
        }
      }
    },
    "仅在预览打开时采集，图片只缓存在内存中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images are captured only while previews are open and cached only in memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在预览打开时采集，图片只缓存在内存中。"
          }
        }
      }
    },
    "仅显示当前显示器的窗口": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Show Windows on the Current Display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示当前显示器的窗口"
