    },
    "%lld 个窗口": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld window"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld windows"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个窗口"
