    "Dock 点击": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Clicks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 点击"
          }
        }
      }
    },
    "点击前台应用的 Dock 图标，收起它在当前桌面的普通窗口；再次点击恢复。其他应用的打开方式保持系统默认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the active app’s Dock icon to minimize its normal windows on the current desktop. Click again to restore them. Other apps open as usual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击前台应用的 Dock 图标，收起它在当前桌面的普通窗口；再次点击恢复。其他应用的打开方式保持系统默认。"
          }
        }
      }
    },
    "显示桌面": {
      "localizations": {
        "en": {
          "stringUnit": {
