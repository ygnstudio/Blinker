              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个窗口"
                }
              }
            }
          }
        }
      }
    },
    "Blinker 不上传规则或窗口内容。你可以跳过授权，之后在设置中开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker does not upload rules or window content. You can skip permissions and enable them in settings later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker 不上传规则或窗口内容。你可以跳过授权，之后在设置中开启。"
          }
        }
      }
    },
    "Blinker 使用引导": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting Started with Blinker"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker 使用引导"
          }
        }
      }
    },
    "Blinker 常驻菜单栏，应用规则和设置使用独立窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker lives in the menu bar. App rules and settings open in their own windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker 常驻菜单栏，应用规则和设置使用独立窗口。"
