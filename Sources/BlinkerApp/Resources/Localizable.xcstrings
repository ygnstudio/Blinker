{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "项目与联系": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project & Contact"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目与联系"
          }
        }
      }
    },
    "规则与窗口内容在本机处理，不上传数据，不收集使用统计。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules and window content are processed on this Mac. No data is uploaded and no usage analytics are collected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则与窗口内容在本机处理，不上传数据，不收集使用统计。"
          }
        }
      }
    },
    "辅助功能用于识别和操作窗口。屏幕录制仅用于可选缩略图，图像只缓存在内存中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is used to identify and control windows. Screen Recording is only needed for optional thumbnails, which are cached in memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能用于识别和操作窗口。屏幕录制仅用于可选缩略图，图像只缓存在内存中。"
          }
        }
      }
    },
    "外部链接由默认浏览器打开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External links open in your default browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部链接由默认浏览器打开。"
          }
        }
      }
    },
    "查看许可证": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View License"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看许可证"
          }
        }
      }
    },
    "允许商业使用和收费分发，分发时须遵守 GPLv3 的源码与许可要求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commercial use and paid distribution are permitted. Distribution must meet the source code and licensing requirements of GPLv3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许商业使用和收费分发，分发时须遵守 GPLv3 的源码与许可要求。"
          }
        }
      }
    },
    "开源许可": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source License"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源许可"
          }
        }
      }
    },
    "macOS 窗口工具": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window controls for macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 窗口工具"
          }
        }
      }
    },
    "自定义红绿灯动作，放大悬停按钮，预览、切换和整理窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize traffic-light actions, enlarge buttons on hover, and preview, switch or arrange windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义红绿灯动作，放大悬停按钮，预览、切换和整理窗口。"
          }
        }
      }
    },
    "源代码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源代码"
          }
        }
      }
    },
    "版本 %@（构建 %@）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (Build %@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@（构建 %@）"
          }
        }
