        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent of button rules. Hover enlargement must also be enabled in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立于按钮规则；还需在设置中开启悬停放大。"
          }
        }
      }
    },
    "用于识别红绿灯、切换与管理窗口。未授权时可以先浏览设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to detect traffic lights, switch windows and manage their layout. You can explore settings before granting access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于识别红绿灯、切换与管理窗口。未授权时可以先浏览设置。"
          }
        }
      }
    },
    "用当前布局覆盖": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overwrite with Current Layout"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用当前布局覆盖"
          }
        }
      }
    },
    "登录时启动 Blinker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch Blinker at Login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动 Blinker"
          }
        }
      }
    },
    "移入预览可切换或管理窗口；移出后稍作停留再关闭，方便从 Dock 移入预览。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move into the preview to switch or manage windows. A short closing delay lets you cross the gap from the Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移入预览可切换或管理窗口；移出后稍作停留再关闭，方便从 Dock 移入预览。"
          }
        }
      }
    },
    "移出后关闭延迟": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay before closing after pointer leaves"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移出后关闭延迟"
          }
        }
      }
    },
    "移到红绿灯上显示更大的按钮，可调整出现延迟和点击保护。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover over the traffic lights for larger buttons. Adjust the appearance delay and click protection in settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到红绿灯上显示更大的按钮，可调整出现延迟和点击保护。"
          }
        }
      }
    },
