    "为应用自定义红绿灯": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize Window Buttons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为应用自定义红绿灯"
          }
        }
      }
    },
    "事件监听启动失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event tap failed to start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件监听启动失败"
          }
        }
      }
