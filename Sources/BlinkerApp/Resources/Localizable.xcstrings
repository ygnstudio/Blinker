    "两个开关独立，关闭后保留配置。悬停按钮还受全局开关和作用范围控制。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These switches are independent. Turning them off keeps your configuration. Hover buttons also follow the global switch and scope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个开关独立，关闭后保留配置。悬停按钮还受全局开关和作用范围控制。"
          }
        }
      }
    },
    "未配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Configured"
          }
        },
        "zh-Hans": {
