        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference angle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考角度"
          }
        }
      }
    },
    "可选，用于窗口缩略图和开合盖屏幕特效。画面只在内存中处理，不录音、不保存录像。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional, for window thumbnails and lid effects. Images are processed only in memory. No audio is captured and no video is saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选，用于窗口缩略图和开合盖屏幕特效。画面只在内存中处理，不录音、不保存录像。"
          }
        }
      }
    },
