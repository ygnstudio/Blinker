    "按住 Option 连按 Tab 选择窗口，松开 Option 打开；Shift 反向，Esc 取消。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Option and press Tab to select a window. Release Option to open it; Shift reverses and Esc cancels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Option 连按 Tab 选择窗口，松开 Option 打开；Shift 反向，Esc 取消。"
          }
        }
      }
    },
    "按应用设置红、黄、绿按钮的动作；没有规则时保留系统行为。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose red, yellow and green button actions for each app. Buttons without rules keep their system behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按应用设置红、黄、绿按钮的动作；没有规则时保留系统行为。"
          }
        }
      }
    },
