      }
    },
    "需要屏幕录制权限。未授权时仍可使用图标和标题，图片只缓存在内存中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires Screen Recording access. Without it, previews still show icons and titles. Images are cached only in memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要屏幕录制权限。未授权时仍可使用图标和标题，图片只缓存在内存中。"
