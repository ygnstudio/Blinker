    "应用未接受操作，请检查窗口是否有待处理的对话框。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app did not accept the action. Check for a pending dialog."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用未接受操作，请检查窗口是否有待处理的对话框。"
          }
        }
      }
    },
    "应用限制了窗口最小尺寸，已尽量保持窗口可见。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app limits its minimum window size. The window has been kept visible where possible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用限制了窗口最小尺寸，已尽量保持窗口可见。"
          }
        }
      }
    },
    "无操作": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Nothing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无操作"
          }
        }
      }
    },
