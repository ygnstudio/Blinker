      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出应用"
          }
        }
      }
    },
    "隐藏应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏应用"
          }
        }
      }
    },
    "需要辅助功能权限，请在系统设置中重新授权。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required. Authorize Blinker in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限，请在系统设置中重新授权。"
