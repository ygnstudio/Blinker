          "stringUnit": {
            "state": "translated",
            "value": "最小化"
          }
        }
      }
    },
    "未连接其他显示器。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other display is connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接其他显示器。"
          }
        }
      }
    },
    "此点击方式未配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Action for This Click"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此点击方式未配置"
          }
        }
      }
    },
    "此窗口不支持该操作，或窗口已关闭。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window does not support the action, or it has closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口不支持该操作，或窗口已关闭。"
          }
        }
      }
    },
    "此窗口没有可还原的布局。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no previous layout for this window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口没有可还原的布局。"
          }
        }
      }
    },
