    "规则文件无效、版本不支持或包含重复的应用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rules file is invalid, uses an unsupported version, or contains duplicate apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则文件无效、版本不支持或包含重复的应用。"
          }
        }
      }
    },
